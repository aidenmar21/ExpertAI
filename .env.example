# Copy to .env.local in web/ and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
VISION_MODEL=
LLM_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=

# Optional multi-tenant persistence: enabled only when all three are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 only after running supabase/migrations/*.sql and seed.sql (see supabase/README.md)
EXPERTAI_USE_SUPABASE=

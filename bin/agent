#!/bin/bash
# Launch a Claude Code session joined to the hub.
#   bin/agent backend                     (hub on this machine)
#   HUB_URL=http://10.0.0.5:8765 bin/agent frontend
set -e
[ -z "$1" ] && { echo "usage: bin/agent NAME [claude args...]"; exit 1; }
cd "$(dirname "$0")/.."
export HUB_AGENT="$1"; shift
export HUB_URL="${HUB_URL:-http://localhost:8765}"
export PATH="$PWD/bin:$PATH"
curl -s -m 3 "$HUB_URL/log" >/dev/null || { echo "can't reach hub at $HUB_URL"; exit 1; }
echo "joining $HUB_URL as '$HUB_AGENT'"
exec claude "$@"

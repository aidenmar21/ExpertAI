{
  "manifest_version": 3,
  "name": "ExpertAI",
  "version": "0.1.0",
  "description": "Your expert's rules on any web app: reads form fields from the page and pauses risky saves before they happen.",
  "minimum_chrome_version": "123",
  "action": {
    "default_title": "Open ExpertAI",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
